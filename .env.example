# Copia questo file in .env e compila i valori

# Chiave segreta per JWT (genera una stringa random lunga)
SECRET_KEY=your-secret-key-change-this-in-production

# Chiave per criptare le password Garmin (deve essere lunga almeno 32 caratteri)
ENCRYPTION_KEY=your-encryption-key-at-least-32-chars

# Database URL (Railway la setta automaticamente se usi il loro PostgreSQL)
# Per sviluppo locale puoi usare SQLite:
DATABASE_URL=sqlite:///garmin_whoop.db

# Per PostgreSQL:
# DATABASE_URL=postgresql://user:password@host:port/database

# AI (OpenAI o endpoint compatibile)
OPENAI_API_KEY=
# OPENAI_BASE_URL=http://localhost:11434/v1   # opzionale: Ollama/vLLM self-hosted
# OPENAI_MODEL_CHAT=gpt-4.1
# OPENAI_MODEL_DEEP=gpt-4o
# OPENAI_MODEL_TTS=gpt-4o-mini-tts
